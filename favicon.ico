<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32">
  <defs>
    <linearGradient id="grad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#2563eb" />
      <stop offset="100%" stop-color="#4f46e5" />
    </linearGradient>
    <filter id="shadow" x="-10%" y="-10%" width="120%" height="120%">
      <feDropShadow dx="0" dy="1" stdDeviation="1" flood-opacity="0.2"/>
    </filter>
  </defs>
  <!-- Background Shield/Card -->
  <rect x="2" y="2" width="28" height="28" rx="7" fill="url(#grad)" filter="url(#shadow)" />
  
  <!-- Document Sheet -->
  <path d="M9 7h9l5 5v13a1 1 0 0 1-1 1H9a1 1 0 0 1-1-1V8a1 1 0 0 1 1-1z" fill="#ffffff" opacity="0.95" />
  
  <!-- Document Fold Corner -->
  <path d="M18 7v4a1 1 0 0 0 1 1h4" fill="#cbd5e1" opacity="0.8" />
  
  <!-- Document Lines -->
  <rect x="11" y="14" width="7" height="2" rx="1" fill="#2563eb" />
  <rect x="11" y="18" width="10" height="2" rx="1" fill="#64748b" />
  <rect x="11" y="21" width="8" height="2" rx="1" fill="#94a3b8" />
  
  <!-- AI Sparkle / Check Accent -->
  <circle cx="23" cy="23" r="4.5" fill="#10b981" />
  <path d="M21.2 23l1.2 1.2 2.5-2.5" fill="none" stroke="#ffffff" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" />
</svg>
